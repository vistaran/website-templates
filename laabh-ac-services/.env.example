# Database (PostgreSQL — Supabase transaction pooler for serverless, direct for migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Admin authentication
JWT_SECRET="generate_a_secure_random_secret_for_production"
NEXT_PUBLIC_APP_URL="https://laabh-ac-services.vercel.app"

# Scheduler secret — required for /api/reminders/process when called without an admin session
CRON_SECRET="generate_a_secure_random_secret_for_cron"

# WhatsApp Business Cloud API (Meta)
# The app accepts either the WHATSAPP_* or the FACEBOOK_* names; FACEBOOK_* win when both are set.
FACEBOOK_ACCESS_TOKEN="your_meta_whatsapp_cloud_api_token"
FACEBOOK_WHATSAPP_PHONE_ID="your_meta_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_meta_business_account_id"
FACEBOOK_WEBHOOK_VERIFY_TOKEN="laabh_ac_services_whatsapp_verify_token_2026"
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_API_URL="https://graph.facebook.com/v22.0"
FACEBOOK_REDIRECT_URI=""

# Vendor notification recipient (digits with country code, e.g. 918758866744)
VENDOR_WHATSAPP_NUMBER="918758866744"
NEXT_PUBLIC_VENDOR_PHONE="918758866744"

# "false" sends real WhatsApp messages via Meta Cloud API; "true" only logs them
WHATSAPP_MOCK_MODE="true"

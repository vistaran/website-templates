# ─────────────────────────────────────────────────────────────────────────────
# G & T Lawn Care — environment variables
#
# Copy to `.env` for local work. For production, set the same keys on the
# Vercel project (Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Calendar booking (optional) ───────────────────────────────────────
# Leave these blank and the site still works end to end: the booking widget
# degrades to a Call / Email panel instead of showing a dead end.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# Calendar that bookings are written to. Use the calendar's own ID, or
# "primary" for the account's main calendar.
GOOGLE_CALENDAR_ID="primary"

# Must match the redirect URI registered on the OAuth client exactly.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/admin/oauth2callback"

# ── Booking rules / timezone ─────────────────────────────────────────────────
# G & T Lawn Care is in Gastonia, NC (Eastern time). Leave America/New_York in
# place — the scaffold's Asia/Kolkata default shifts every slot label by 9.5 hours.
BUSINESS_TIMEZONE="America/New_York"

# Slot length and the bookable window (24-hour clock, local to the timezone
# above). 8 → 17 yields 30-minute slots from 8:00 AM to 4:30 PM.
BOOKING_SLOT_MINUTES="30"
BOOKING_START_HOUR="8"
BOOKING_END_HOUR="17"

# ── Admin ────────────────────────────────────────────────────────────────────
# Protects /api/admin/* — required to run the Google OAuth flow at
# /api/admin/google-calendar, which prints the refresh token to paste above.
ADMIN_PASSWORD=""

# ---- Google Calendar booking (optional) -------------------------------------
# Without these the site still works: the booking widget automatically falls
# back to "call / email us" CTAs instead of showing unavailable times.
# Generate a refresh token once via server.js -> /api/admin/google-calendar.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# Calendar to write bookings into ("primary" = the account's main calendar)
GOOGLE_CALENDAR_ID="primary"

# Local dev / one-time OAuth admin connect (server.js only)
ADMIN_PASSWORD=""
GOOGLE_REDIRECT_URI=""

# ---- Booking window ---------------------------------------------------------
# IANA timezone of the business (the crew's local time)
BUSINESS_TIMEZONE="America/New_York"
TIMEZONE="America/New_York"
BOOKING_START_HOUR="8"
BOOKING_END_HOUR="17"
BOOKING_SLOT_MINUTES="30"
